# Comma-separated directories that the scanner may read.
LOCAL_RAG_HOME=~/.local-rag

# Optional OpenAI-compatible endpoint (OpenRouter works here). No request is
# made unless the relevant adapter is explicitly enabled by application code.
LOCAL_RAG_EMBEDDING_PROVIDER=none
LOCAL_RAG_EMBEDDING_MODEL=
LOCAL_RAG_OPENAI_BASE_URL=https://openrouter.ai/api/v1
LOCAL_RAG_OPENAI_API_KEY=
LOCAL_RAG_METADATA_MODEL=
