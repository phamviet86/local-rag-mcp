# Copy to an operator-managed location, replace the absolute data-root path, and
# keep the resulting file out of version control. This file is not loaded by the
# service automatically.
LOCAL_RAG_MCP_HOME=/absolute/path/to/.local-rag
LOCAL_RAG_MCP_PROFILE=reader

# Optional OpenAI-compatible endpoint (OpenRouter works here). No request is
# made unless the relevant adapter is explicitly enabled by application code.
LOCAL_RAG_MCP_EMBEDDING_PROVIDER=none
LOCAL_RAG_MCP_EMBEDDING_MODEL=
LOCAL_RAG_MCP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
LOCAL_RAG_MCP_OPENAI_API_KEY=

# Existing LOCAL_RAG_HOME / LOCAL_RAG_* embedding variables remain supported.
# Optional extras use the unique distribution name phamviet-local-rag-mcp; install
# them from this repository's GitHub Release, never the unrelated local-rag-mcp PyPI package.
