LOCAL_RAG_MCP_HOME=~/.local-rag

# Optional OpenAI-compatible endpoint (OpenRouter works here). No request is
# made unless the relevant adapter is explicitly enabled by application code.
LOCAL_RAG_MCP_EMBEDDING_PROVIDER=none
LOCAL_RAG_MCP_EMBEDDING_MODEL=
LOCAL_RAG_MCP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
LOCAL_RAG_MCP_OPENAI_API_KEY=

# Existing LOCAL_RAG_HOME / LOCAL_RAG_* embedding variables remain supported.
